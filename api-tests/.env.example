RHOMBUS_API_BASE=https://<api-host-from-network-tab>
RHOMBUS_TOKEN=<copy from the Authorization header of any logged-in request; do NOT commit>
RHOMBUS_AUTH_HEADER=Authorization
RHOMBUS_AUTH_SCHEME=Bearer
RHOMBUS_PIPELINES_PATH=/path/that/lists/pipelines
RHOMBUS_SCHEDULE_PATH=/path/to/schedule/{id}
RHOMBUS_PIPELINE_ID=<id>
